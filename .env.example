# Copy to repo root `.env` — used by both API and Vite (web).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/running_club
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Browser → API (Vite only exposes VITE_* to the client)
VITE_API_URL=http://localhost:8787

# Google sign-in (optional). Callback is on the API origin:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Club miss emails (optional). Without these, the nudge job no-ops.
# RESEND_API_KEY=
# EMAIL_FROM=CUP Run <onboarding@resend.dev>
