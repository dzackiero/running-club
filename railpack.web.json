{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        "pnpm install --filter @running-club/web... --frozen-lockfile"
      ]
    },
    "build": {
      "commands": [
        "pnpm --filter @running-club/web build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npx --yes serve -s apps/web/dist -l tcp://0.0.0.0:${PORT:-80}",
    "variables": {
      "NODE_OPTIONS": "--max-old-space-size=512"
    }
  }
}
