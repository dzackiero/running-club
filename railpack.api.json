{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        "pnpm install --filter @running-club/api... --frozen-lockfile"
      ]
    },
    "build": {
      "commands": [
        "pnpm --filter @running-club/api build"
      ]
    }
  },
  "deploy": {
    "startCommand": "node apps/api/dist/index.js",
    "variables": {
      "NODE_OPTIONS": "--max-old-space-size=512"
    }
  }
}
